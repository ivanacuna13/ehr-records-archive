{"id":2921,"age":16,"sex":"F","race":"Hispanic","insurance":"Commercial insurance (dependent coverage)","profile":{"sex":"F","allergies":["No known drug allergies"],"insurance":"Commercial insurance (dependent coverage)","occupation":"High school student","alcohol_use":"None","family_history":["Mother with history of severe dysmenorrhea","Older sister with primary dysmenorrhea"],"race_ethnicity":"Hispanic","smoking_status":"Never","home_medications":[],"surgical_history":[],"chronic_conditions":[],"age_at_first_encounter":16},"comorbidities_listed":[],"primary":{"did":4130,"code":"N94.4","name":"Primary dysmenorrhea"},"filing":{"chapter":14,"block":"N80-N98","block_desc":"Noninflammatory disorders of female genital tract (N80-N98)"},"encounters":[{"id":12360,"date":"2020-01-15","type":"outpatient","dept":"Obstetrics & Gynecology","attending":"Dr. Maria Gonzalez","cc":"Recurrent lower abdominal pain with menses for 6 months","order":0,"method":"template","question_ids":[6536],"sections":[{"sid":60242,"type":"chief_complaint","lines":["Recurrent lower abdominal pain with menses for 6 months"]},{"sid":60243,"type":"hpi","lines":["The discomfort has been present for the past 6 months and is described as cramping and pressure-like.","The pain typically begins a few hours before the onset of her menstrual bleeding and peaks during the first 1\u20132 days of her period.","It is severe enough to cause her to miss classes at school and sometimes requires her to stay in bed.","She began menstruating at age 12, and her cycles are regular every 28\u201330 days, lasting about 5 days.","The bleeding is moderate, with no clots or excessive flow.","She denies fever, dysuria, constipation, diarrhea, or abnormal vaginal discharge.","She does not report pain outside of her menstrual cycles."]},{"sid":60244,"type":"pmh","lines":["She is otherwise healthy and has no history of chronic illness."]},{"sid":60245,"type":"medications","lines":["She takes no medications"]},{"sid":60246,"type":"allergies","lines":["No known drug allergies"]},{"sid":60247,"type":"family_history","lines":["There is no family history of gynecologic disorders."]},{"sid":60248,"type":"social_history","lines":["She is not sexually active, has not been pregnant.","She eats well, has no recent weight loss, and participates in school sports when not limited by her cramps."]},{"sid":60249,"type":"vitals","lines":["On examination, her vital signs are normal."]},{"sid":60250,"type":"physical_exam","lines":["She appears uncomfortable but is afebrile.","Her abdomen is soft and non-tender with no rebound or guarding.","Pelvic exam is deferred at the patient's and mother's request, but there is no abdominal mass, organomegaly, or palpable pelvic fullness.","The remainder of the physical exam is unremarkable."]}],"orders":[]},{"id":12358,"date":"2020-07-15","type":"telehealth","dept":"Obstetrics & Gynecology","attending":"Dr. Sarah Chen","cc":"Follow-up for painful menstrual cramps now present for 1 year","order":1,"method":"hybrid","question_ids":[3178],"sections":[{"sid":60251,"type":"chief_complaint","lines":["Follow-up for painful menstrual cramps now present for 1 year"]},{"sid":60252,"type":"hpi","lines":["The patient returns for follow-up evaluation of recurrent menstrual pain, having been evaluated in January 2020 for similar complaints.","She presents with a 1-year history of painful menstrual cramps that begin on the first day of menses and last for 2-3 days.","She reports that the pain is severe enough to interfere with her school activities and that she often has to miss school during her period.","She also experiences fatigue, nausea, and loose stools during her periods.","Her menstrual cycles are regular, with a 28-day cycle and 5 days of bleeding."]},{"sid":60253,"type":"pmh","lines":["Active Problem List:","- Primary dysmenorrhea (diagnosed 2020-01-15)"]},{"sid":60254,"type":"medications","lines":["She takes no medications."]},{"sid":60255,"type":"allergies","lines":["No known drug allergies"]},{"sid":60256,"type":"family_history","lines":["- Mother with history of severe dysmenorrhea","- Older sister with primary dysmenorrhea"]},{"sid":60257,"type":"social_history","lines":["She has never been sexually active."]},{"sid":60258,"type":"vitals","lines":["On physical examination, her vital signs are within normal limits,"]},{"sid":60259,"type":"physical_exam","lines":["Her abdominal and pelvic examinations are normal."]},{"sid":60260,"type":"labs","lines":["Laboratory values:","- Hemoglobin: 13.2 g/dL","- White blood cell count: 7,000/mm^3","- Platelets: 250,000/mm^3","- Thyroid-stimulating hormone (TSH): 2.5 mIU/L","- Human chorionic gonadotropin (hCG): Negative"]}],"orders":[]},{"id":12359,"date":"2021-01-15","type":"ed","dept":"Emergency Medicine","attending":"Dr. James O'Brien","cc":"Severe cyclical lower abdominal pain refractory to medications","order":2,"method":"hybrid","question_ids":[6533],"sections":[{"sid":60261,"type":"chief_complaint","lines":["Severe cyclical lower abdominal pain refractory to medications"]},{"sid":60262,"type":"hpi","lines":["The patient is a 17-year-old female with a history of primary dysmenorrhea previously evaluated in the Obstetrics and Gynecology clinic in January and July 2020, who presents to the emergency department with severe cyclical lower abdominal pain.","She reports that her symptoms began approximately one year after she started menstruating at age 13.","She describes the pain as intense cramping in the suprapubic area that begins several hours before the onset of her period and typically lasts for the first 48\u201372 hours of her menses.","She reports associated symptoms of fatigue, nausea, headache, and occasional loose stools but denies vomiting, fever, chills, or abnormal vaginal discharge.","She notes that the pain can sometimes cause her to miss school or extracurricular activities.","Over-the-counter ibuprofen and a heating pad are helpful in reducing the severity of her symptoms.","Her menstrual cycles are regular every 28\u201330 days, with 4\u20135 days of moderate flow and no intermenstrual bleeding.","She denies pelvic pain at other times in the cycle, pain with urination or defecation, or pain with exercise.","She is not sexually active and has never had a pelvic exam or abdominal imaging."]},{"sid":60263,"type":"pmh","lines":["Active Problem List:","- Primary dysmenorrhea (diagnosed 2020-01-15)","","Her medical and surgical histories are unremarkable."]},{"sid":60264,"type":"allergies","lines":["No known drug allergies"]},{"sid":60265,"type":"family_history","lines":["Family history is notable for her mother having similar symptoms as a teenager that improved after starting birth control pills."]},{"sid":60266,"type":"social_history","lines":["Smoking: Never. Alcohol: None. Occupation: High school student."]},{"sid":60267,"type":"physical_exam","lines":["On physical examination, her abdomen is soft and non-tender, without masses or guarding.","A pelvic exam is deferred due to her age and lack of sexual activity."]}],"orders":[]}],"problems":[{"did":4130,"code":"N94.4","name":"Primary dysmenorrhea","icd_desc":"Primary dysmenorrhea","snomed":"65754002","snomed_desc":"Primary dysmenorrhea","category":"Obstetric","acuity":"acute","kind":"active","first_enc":12360,"chapter":14,"block":"N80-N98","docs":[{"enc":12360,"how":"encounter diagnosis"},{"enc":12358,"how":"encounter diagnosis"},{"enc":12359,"how":"encounter diagnosis"}],"primary":true},{"did":1312,"code":"Z00.8","name":"Normal sinus rhythm","icd_desc":"Encounter for other general examination","snomed":"64730000","snomed_desc":"Normal sinus rhythm","category":"Cardiovascular","acuity":"chronic","kind":"secondary","first_enc":12360,"chapter":21,"block":"Z00-Z13","docs":[{"enc":12360,"how":"secondary diagnosis"}],"primary":false},{"did":6138,"code":"Z87.5","name":"Primigravida status","icd_desc":null,"snomed":"16216731000119106","snomed_desc":"Past pregnancy history of intrauterine fe