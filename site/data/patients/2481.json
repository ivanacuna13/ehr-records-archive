{"id":2481,"age":6,"sex":"M","race":"Non-Hispanic White","insurance":"Private insurance (Aetna)","profile":{"sex":"M","allergies":["NKDA"],"insurance":"Private insurance (Aetna)","occupation":"Elementary school student (1st grade)","alcohol_use":"None","family_history":["No family history of thyroid malignancy","No family history of congenital neck masses or cysts","Mother with seasonal allergies"],"race_ethnicity":"Non-Hispanic White","smoking_status":"Never","home_medications":[],"surgical_history":[],"chronic_conditions":[],"age_at_first_encounter":6},"comorbidities_listed":[],"primary":{"did":5140,"code":"Q89.2","name":"Thyroglossal duct cyst"},"filing":{"chapter":17,"block":"Q80-Q89","block_desc":"Other congenital malformations (Q80-Q89)"},"encounters":[{"id":10578,"date":"2020-01-15","type":"outpatient","dept":"General Pediatrics","attending":"Dr. Sarah Chen","cc":"small neck mass they noticed 3 weeks ago","order":0,"method":"template","question_ids":[6777],"sections":[{"sid":41408,"type":"chief_complaint","lines":["Small neck mass they noticed 3 weeks ago"]},{"sid":41409,"type":"hpi","lines":["He is brought to the pediatric clinic by his parents due to a small neck mass they noticed 3 weeks ago.","The parents report that the mass has remained the same size since they first noticed it and does not seem to cause the child any pain or discomfort.","He has had no recent fever, sore throat, difficulty swallowing, or changes in voice."]},{"sid":41410,"type":"pmh","lines":["His past medical history is unremarkable, and immunizations are up to date.","He was born at term via spontaneous vaginal delivery with no complications."]},{"sid":41411,"type":"allergies","lines":["NKDA"]},{"sid":41412,"type":"family_history","lines":["- No family history of thyroid malignancy","- No family history of congenital neck masses or cysts","- Mother with seasonal allergies"]},{"sid":41413,"type":"social_history","lines":["Smoking: Never. Alcohol: None. Occupation: Elementary school st