{"id":2810,"age":36,"sex":"F","race":"Non-Hispanic White","insurance":"Employer-sponsored Blue Cross Blue Shield PPO","profile":{"sex":"F","allergies":["NKDA"],"insurance":"Employer-sponsored Blue Cross Blue Shield PPO","occupation":"Elementary School Teacher","alcohol_use":"None","family_history":["Mother with rheumatoid arthritis","Father with type 2 diabetes mellitus","Sister with hypothyroidism"],"race_ethnicity":"Non-Hispanic White","smoking_status":"Never smoker","home_medications":[{"dose":"15 mg PO weekly","name":"Methotrexate"},{"dose":"1 mg PO daily","name":"Folic acid"},{"dose":"5 mg PO daily","name":"Prednisone"},{"dose":"325 mg PO daily","name":"Ferrous sulfate"},{"dose":"400 mg PO every 6 hours PRN joint pain","name":"Ibuprofen"}],"surgical_history":["Tonsillectomy","Wisdom teeth extraction"],"chronic_conditions":["Seropositive rheumatoid arthritis","Chronic anemia"],"age_at_first_encounter":36},"comorbidities_listed":["Rheumatoid arthritis"],"primary":{"did":871,"code":"D63.8","name":"Chronic anemia"},"filing":{"chapter":3,"block":"D60-D64","block_desc":"Aplastic and other anemias and other bone marrow failure syndromes (D60-D64)"},"encounters":[{"id":11849,"date":"2020-01-15","type":"outpatient","dept":"Rheumatology","attending":"Dr. Elena Vasquez","cc":"Joint pain, fatigue, and low energy","order":0,"method":"template","question_ids":[5605],"sections":[{"sid":54817,"type":"chief_complaint","lines":["Joint pain, fatigue, and low energy"]},{"sid":54818,"type":"hpi","lines":["Over the past 9 months, she has had gradually worsening morning stiffness in her wrists, knees, and small joints of the hands, especially the second and third metacarpophalangeal (MCP) and proximal interphalangeal (PIP) joints.","The stiffness lasts nearly two hours each morning before improving.","She has difficulty opening jars, typing, and occasionally needs help with grooming.","She also reports persistent fatigue and has noticed that her skin appears \"pale\" in photos."]},{"sid":54819,"type":"pmh","lines":["Active Problem List:","- Seropositive rheumatoid arthritis","- Chronic anemia"]},{"sid":54820,"type":"psh","lines":["- Tonsillectomy","- Wisdom teeth extraction"]},{"sid":54821,"type":"medications","lines":["Home Medications:","- Methotrexate 15 mg PO weekly","- Folic acid 1 mg PO daily","- Prednisone 5 mg PO daily","- Ferrous sulfate 325 mg PO daily","- Ibuprofen 400 mg PO every 6 hours PRN joint pain"]},{"sid":54822,"type":"allergies","lines":["NKDA"]},{"sid":54823,"type":"family_history","lines":["- Mother with rheumatoid arthritis","- Father with type 2 diabetes mellitus","- Sister with hypothyroidism"]},{"sid":54824,"type":"social_history","lines":["Smoking: Never smoker. Alcohol: None. Occupation: Elementary School Teacher."]},{"sid":54825,"type":"ros","lines":["She denies gastrointestinal symptoms, blood loss, heavy menses, or dietary restrictions."]},{"sid":54826,"type":"vitals","lines":["Her vital signs are normal"]},{"sid":54827,"type":"physical_exam","lines":["There is symmetric swelling and tenderness in both wrists and the second and third MCPs bilaterally.","The DIP joints are spared."]},{"sid":54828,"type":"labs","lines":["Laboratory studies show hemoglobin of 10.3 g/dL, mean corpuscular volume of 84 fL, white blood cell count of 7,100/\u03bcL, and platelet count of 421,000/\u03bcL.","Erythrocyte sedimentation rate is 68 mm/hr and C-reactive protein is 34 mg/L.","Ferritin is normal, serum iron is low, and transferrin is low.","Additional testing is positive for rheumatoid factor and anti\u2013cyclic citrullinated peptide antibodies."]}],"orders":[]},{"id":11850,"date":"2022-01-15","type":"ed","dept":"Emergency Medicine","attending":"Dr. Kwame Asante","cc":"Progressive cough, fever, weight loss, and night sweats over the past 6 weeks","order":1,"method":"hybrid","question_ids":[4623],"sections":[{"sid":54829,"type":"chief_complaint","lines":["Progressive cough, fever, weight loss, and night sweats over the past 6 weeks"]},{"sid":54830,"type":"hpi","lines":["The patient is a 38-year-old female with seropositive rheumatoid arthritis and chronic anemia initially documented during a rheumatology encounter in 2020 who presents to the emergency department with progressive respiratory and constitutional symptoms.","She states that she first noticed mild fatigue and reduced appetite but attributed it to work-related stress.","Over time, she developed an intermittent cough productive of yellow sputum and occasional streaks of blood.","She has also lost 12 pounds unintentionally in the past 2 months.","The night sweats have worsened, and she now wakes up drenched in sweat several times per week."]},{"sid":54831,"type":"pmh","lines":["Active Problem List:","- Chronic anemia (diagnosed 2020-01-15)","- Seropositive rheumatoid arthritis","","Her medical history is significant for seropositive rheumatoid arthritis, diagnosed 4 years ago.","Initially she was treated with nonsteroidal anti-inflammatory drugs and low-dose prednisone for symptom control.","She was then started on methotrexate, which helped temporarily, but her disease flared with persistent joint pain, swelling, and morning stiffness.","Five months ago, she was started on adalimumab because her arthritis was inadequately controlled.","Her joint pain has since improved dramatically, and she was able to taper off prednisone completely.","However, she recalls a positive tuberculin skin test during college, when she participated in a volunteer program in India, but she never received treatment at that time."]},{"sid":54832,"type":"psh","lines":["- Tonsillectomy","- Wisdom teeth extraction"]},{"sid":54833,"type":"medications","lines":["Home Medications:","- Methotrexate 15 mg PO weekly","- Folic acid 1 mg PO daily","- Prednisone 5 mg PO daily","- Ferrous sulfate 325 mg PO daily","- Ibuprofen 400 mg PO every 6 hours PRN joint pain"]},{"sid":54834,"type":"allergies","lines":["NKDA"]},{"sid":54835,"type":"family_history","lines":["Family history is notable only for hypertension in her parents."]},{"sid":54836,"type":"social_history","lines":["She works as a schoolteacher and lives with her husband and two young children.","She does not drink alcohol, use recreational drugs, or smoke."]},{"sid":54837,"type":"vitals","lines":["Her temperature is 38.3\u00b0C (100.9\u00b0F), blood pressure 110/70 mm Hg, pulse 96/min, and respirations 20/min.","Oxygen saturation is 95% on room air."]},{"sid":54838,"type":"physical_exam","lines":["On physical examination, the patient is tired-appearing and underweight.","Auscultation of the lungs reveals crackles over the right upper lobe.","Mild cervical lymphadenopathy is present.","Examination of her hands shows decreased swelling and tenderness of the metacarpophalangeal joints, consistent with good control of her arthritis on adalimumab."]},{"sid":54839,"type":"labs","lines":["Laboratory studies reveal normocytic anemia, an elevated erythrocyte sedimentation rate, and a C-reactive protein level mildly above normal.","HIV test is negative.","Three sputum samples are positive for acid-fast bacilli on Ziehl-Neelsen staining."]},{"sid":54840,"type":"imaging","lines":["Chest x-ray demonstrates cavitary lesions in the upper lobes of both lungs."]}],"orders":[{"order_id":1681,"modality":"xray","region":"chest","indication":"cough, fever, hemoptysis","provider":"Dr. Kwame Asante","priority":"stat","datetime":"2022-01-15","result_sid":54840}]}],"problems":[{"did":871,"code":"D63.8","name":"Chronic anemia","icd_desc":"Anemia in other chronic diseases classified elsewhere","snomed":"191268006","snomed_desc":"Chronic anemia","category":"Hematologic","acuity":"chronic","kind":"chronic","first_enc":11849,"chapter":3,"block":"D60-D64","docs":[{"enc":11849,"how":"encounter diagnosis"},{"enc":11850,"how":"problem list mention"}],"primary":true},{"did":751,"code":"A15.0","name":"Tuberculosis","icd_desc":"Tuberculosis of lung","snomed":"56717001","snomed_desc":"Tuberculosis","category":